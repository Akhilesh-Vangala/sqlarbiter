# Private .env is auto-loaded with override=False; existing process variables take precedence.
SQLARBITER_STATE_DIR=artifacts/generated/app
SQLARBITER_OPERATOR_NAME=local-operator
# Optional shared operator access; required before exposing a public service.
SQLARBITER_ACCESS_TOKEN=
SQLARBITER_PUBLIC_ORIGIN=
# Durable queue/checkpoint database. Compose constructs these URLs from the
# private password below; managed deployments inject complete secret URLs.
SQLARBITER_POSTGRES_PASSWORD=
# SQLARBITER_DATABASE_URL=
# SQLARBITER_CHECKPOINT_DATABASE_URL=
SQLARBITER_DATABASE_POOL_SIZE=5
# Optional billable hosted investigator.
ANTHROPIC_API_KEY=
SQLARBITER_ANTHROPIC_MODEL=claude-sonnet-5-5
# Estimated application allowance; unknown requests retain their reservation.
# Total is cumulative for this ledger, not a monthly reset or provider invoice cap.
SQLARBITER_RUN_BUDGET_USD=1
SQLARBITER_TOTAL_BUDGET_USD=5
# Optional overrides: defaults are state-dir/spend.sqlite and the checked-in pricing profile.
# SQLARBITER_SPEND_LEDGER=
# SQLARBITER_PRICE_PROFILE=

# SQLite remains available as a development analytical backend.
SQLARBITER_SQL_ENGINE=duckdb
# Optional OTLP/HTTP endpoint; Docker Compose defaults to its Phoenix collector.
SQLARBITER_OTLP_ENDPOINT=
# Optional trusted dbt tooling binary; defaults to .venv-dbt/bin/dbt locally.
# Containers provide /opt/dbt/bin/dbt in a separate pinned tooling environment.
# SQLARBITER_DBT_EXECUTABLE=

# Optional account workspace; disabled until BOTH values and the SQL migration exist.
# Public/anon key only: never a service-role or secret key.
# SQLARBITER_SUPABASE_URL=https://your-project.supabase.co
# SQLARBITER_SUPABASE_PUBLISHABLE_KEY=
# Self-registration requires operator configuration of email confirmation,
# SMTP, Site URL, allowed redirects and provider rate controls. Off by default.
SQLARBITER_ACCOUNT_SIGNUP=0
# Stable report-signing secret (48+ characters). Public deployments may reuse
# their existing private SQLARBITER_DEMO_SECRET; local unsigned-key fallback is ephemeral.
# SQLARBITER_REPORT_SIGNING_KEY=
