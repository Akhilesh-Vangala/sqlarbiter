# Private .env is auto-loaded with override=False; existing process variables take precedence.
VDIR_STATE_DIR=artifacts/generated/app
VDIR_OPERATOR_NAME=local-operator
# Optional shared operator access; required before exposing a public service.
VDIR_ACCESS_TOKEN=
VDIR_PUBLIC_ORIGIN=
# Durable queue/checkpoint database. Compose constructs these URLs from the
# private password below; managed deployments inject complete secret URLs.
VDIR_POSTGRES_PASSWORD=
# VDIR_DATABASE_URL=
# VDIR_CHECKPOINT_DATABASE_URL=
VDIR_DATABASE_POOL_SIZE=5
# Optional billable hosted investigator.
ANTHROPIC_API_KEY=
VDIR_ANTHROPIC_MODEL=claude-sonnet-5-5
# Estimated application allowance; unknown requests retain their reservation.
# Total is cumulative for this ledger, not a monthly reset or provider invoice cap.
VDIR_RUN_BUDGET_USD=1
VDIR_TOTAL_BUDGET_USD=5
# Optional overrides: defaults are state-dir/spend.sqlite and the checked-in pricing profile.
# VDIR_SPEND_LEDGER=
# VDIR_PRICE_PROFILE=

# SQLite remains available as a development analytical backend.
VDIR_SQL_ENGINE=duckdb
# Optional OTLP/HTTP endpoint; Docker Compose defaults to its Phoenix collector.
VDIR_OTLP_ENDPOINT=
# Optional trusted dbt tooling binary; defaults to .venv-dbt/bin/dbt locally.
# Containers provide /opt/dbt/bin/dbt in a separate pinned tooling environment.
# VDIR_DBT_EXECUTABLE=
