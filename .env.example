# Private .env is auto-loaded with override=False; existing process variables take precedence.
VDIR_STATE_DIR=artifacts/generated/app
VDIR_OPERATOR_NAME=local-operator
# Optional shared operator access; required before exposing a public service.
VDIR_ACCESS_TOKEN=
VDIR_PUBLIC_ORIGIN=
# Optional billable hosted investigator.
ANTHROPIC_API_KEY=
VDIR_ANTHROPIC_MODEL=claude-sonnet-5-5

# SQLite remains available as a development analytical backend.
VDIR_SQL_ENGINE=duckdb
# Optional OTLP/HTTP endpoint; Docker Compose defaults to its Phoenix collector.
VDIR_OTLP_ENDPOINT=
